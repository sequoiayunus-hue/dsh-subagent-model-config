{
  "name": "dsh-subagent-model-config",
  "version": "0.1.0",
  "description": "Configure per-teammate model & reasoning effort for DeepSeek Harness native agent teams, with a settings UI. 为 DSH 原生 Team 编队队员可视化配置模型与推理档位。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.1.7-alpha.1 <0.2.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "author": {
    "name": "sequoiayunus-hue",
    "url": "https://github.com/sequoiayunus-hue"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sequoiayunus-hue/dsh-subagent-model-config.git"
  },
  "bugs": {
    "url": "https://github.com/sequoiayunus-hue/dsh-subagent-model-config/issues"
  },
  "homepage": "https://github.com/sequoiayunus-hue/dsh-subagent-model-config#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subagent",
    "team",
    "teammate",
    "model-config",
    "reasoning-effort"
  ]
}
